# Normalise line endings: batch and PowerShell files must stay CRLF on checkout,
# everything else may be LF.
* text=auto eol=lf

*.cmd text eol=crlf
*.cmd -text
*.ps1 text eol=crlf
*.cs  text eol=crlf
*.md  text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.html text eol=lf
*.css text eol=lf

*.exe binary
*.ico binary
*.png binary

# Collapse generated files in diffs and reviews
build/*.exe linguist-generated=true
docs/assets/*.css linguist-vendored=false
